{
  "name": "@yiyunet/dsh-kill-ai-slop",
  "version": "0.3.6",
  "description": "DSH 插件：AI垃圾过滤（Kill AI Slop）——对收到的文件做表达水分体检（AI Slop：套话、重复、模板化、模糊等没有信息量的表达填充），并用「交付承接台账」审查工作空转（Work Slop：把本该完成的决策与执行组织转嫁给接收者）：义务逐条记账、引文逐条复核。零依赖、零联网、纯本地计算，附设置面板。 Score documents for AI-slop and audit work-slop with an obligation ledger whose every quote is machine-verified against the source, then distill them into five faithful elements. Fully offline, zero runtime dependencies, with a settings panel.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ai-slop",
    "work-slop",
    "document-quality",
    "document-review",
    "text-analysis",
    "summarization",
    "faithful-extraction",
    "docx",
    "pdf",
    "office",
    "offline",
    "privacy"
  ],
  "author": {
    "name": "yiyunet",
    "url": "https://github.com/yiyunet"
  },
  "contributors": [
    {
      "name": "yiyunet",
      "url": "https://github.com/yiyunet"
    }
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yiyunet/dsh-kill-ai-slop.git"
  },
  "homepage": "https://github.com/yiyunet/dsh-kill-ai-slop#readme",
  "bugs": {
    "url": "https://github.com/yiyunet/dsh-kill-ai-slop/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "lib",
    "plugin-src",
    "scripts",
    "test",
    "cordis.patch.yml",
    "LICENSE",
    "CHANGELOG.md",
    "CONTEXT.md",
    "THIRD_PARTY_NOTICES.md",
    "OBLIGATIONS.md",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": "0.1.2-alpha.4 || 0.1.2-alpha.5 || 0.1.2-rc.1 || 0.1.3-alpha.1 || 0.1.5-alpha.1",
      "dshReleases": {
        "0.1.2-alpha.4": "compatible",
        "0.1.2-alpha.5": "compatible",
        "0.1.2-rc.1": "compatible",
        "0.1.3-alpha.1": "compatible",
        "0.1.5-alpha.1": "compatible"
      },
      "profiles": [
        "web"
      ]
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/text.test.mjs test/parse.test.mjs test/rules-score.test.mjs test/distill-audit.test.mjs test/obligations.test.mjs",
    "verify": "node scripts/verify-package.mjs",
    "doctor": "node scripts/doctor.mjs",
    "check": "npm run build && npm test && npm run verify",
    "prepare": "node scripts/build.mjs",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "directories": {
    "lib": "lib",
    "test": "test"
  }
}
